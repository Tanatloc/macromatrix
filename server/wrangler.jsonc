// Worker "macromatrix-api" (api.macromatrix.eu). Geen geheimen hier: die staan als Worker-secrets bij Cloudflare.
// Account: via de omgevingsvariabele CLOUDFLARE_ACCOUNT_ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "macromatrix-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // UserHub: één Durable Object per gebruiker voor live meldingen (src/hub.js)
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
  "env": {
    // Testomgeving: kopie van de productiedata (tool/supabase_to_d1.mjs), EU-jurisdictie
    "staging": {
      "name": "macromatrix-api-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "api-staging.macromatrix.eu", "custom_domain": true }],
      "vars": {
        "BASE_URL": "https://api-staging.macromatrix.eu",
        // Mails naar dit domein gaan naar de tabel test_outbox (automatische tests); bestaat niet echt
        "TEST_OUTBOX_DOMAIN": "test.macromatrix.invalid",
        "EXTRA_ORIGINS": "http://localhost:8931,https://staging.macromatrix.eu"
      },
      // 02:30 opruimen + back-up, de 1e van de maand om 04:00 de hersteltest
      "triggers": { "crons": ["30 2 * * *", "0 4 1 * *"] },
      // Back-ups en de hersteltest lezen en schrijven de hele database: ruimer dan de standaard 30 s rekentijd
      "limits": { "cpu_ms": 300000 },
      "r2_buckets": [{ "binding": "BACKUP", "bucket_name": "macromatrix-backup-staging", "jurisdiction": "eu" }],
      // Cloudflare Email Sending (macromatrix.eu is aangemeld); alleen deze afzender
      "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["noreply@macromatrix.eu"] }],
      "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "UserHub" }] },
      "ratelimits": [
        { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
        // Per gebruiker op /v1: ruim boven wat de app doet (sync, functies), tegen misbruik met een geldige sessie
        { "name": "API_LIMIT", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "macromatrix-staging",
          "database_id": "769e5567-132b-4aac-94fc-8e001d615d73",
          "migrations_dir": "migrations"
        },
        // Alleen voor de maandelijkse hersteltest (wordt telkens leeggemaakt en opnieuw gevuld)
        {
          "binding": "RESTORE_DB",
          "database_name": "macromatrix-restoretest",
          "database_id": "85a276f0-3eb2-446f-9f7a-f36e71fc3a39",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
