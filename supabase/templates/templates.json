{
 "mailer_subjects_confirmation": "Your MacroMatrix code: {{ .Token }}",
 "mailer_templates_confirmation_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#F4F3EF\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF\">\n  <tr><td align=\"center\" style=\"padding:32px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px;background:#FFFFFF;border:1px solid #E4E1DA;border-radius:20px;overflow:hidden\">\n      <tr><td style=\"background:#0D0F11;padding:22px 28px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n          <td style=\"padding-right:12px\"><img src=\"https://app.divinenet.online/assets/img/logo-112.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;color:#ECEDEF\">MacroMatrix</td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"font-size:0;line-height:0;height:4px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr>\n          <td width=\"38%\" style=\"background:#8FA3FF;height:4px\"></td><td width=\"37%\" style=\"background:#E3A956;height:4px\"></td><td width=\"25%\" style=\"background:#E08BAA;height:4px\"></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:30px 28px 30px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.3px;color:#15171A;padding-bottom:10px\">Welcome to MacroMatrix</td></tr>\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#4B5058\">Type this code in the app to confirm your email address and get started:</td></tr>\n          <tr><td style=\"padding:24px 0 6px\">\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF;border:1px solid #E4E1DA;border-radius:14px\">\n              <tr><td align=\"center\" style=\"padding:22px 12px\">\n                <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:36px;font-weight:700;letter-spacing:10px;color:#15171A\">{{ .Token }}</div>\n                <div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#676C75;padding-top:8px\">Valid for 15 minutes</div>\n              </td></tr>\n            </table>\n          </td></tr>\n          <tr><td style=\"padding:18px 0 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#4B5058\">Next, you tell us a little about yourself and we calculate your personal targets for all 69 nutrients.</td></tr>\n          <tr><td style=\"padding-top:22px;border-bottom:1px solid #E4E1DA\"></td></tr>\n          <tr><td style=\"padding-top:18px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:#676C75\">Didn't ask for this? You can safely ignore this email.</td></tr>\n        </table>\n      </td></tr>\n    </table>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px\">\n      <tr><td align=\"center\" style=\"padding:18px 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#8B919A\">\n        MacroMatrix by DivineNet \u00b7 <a href=\"https://app.divinenet.online\" style=\"color:#8B919A\">app.divinenet.online</a><br>\n        You get this email because of an action on your MacroMatrix account.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>\n",
 "mailer_subjects_magic_link": "Your MacroMatrix login code: {{ .Token }}",
 "mailer_templates_magic_link_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#F4F3EF\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF\">\n  <tr><td align=\"center\" style=\"padding:32px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px;background:#FFFFFF;border:1px solid #E4E1DA;border-radius:20px;overflow:hidden\">\n      <tr><td style=\"background:#0D0F11;padding:22px 28px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n          <td style=\"padding-right:12px\"><img src=\"https://app.divinenet.online/assets/img/logo-112.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;color:#ECEDEF\">MacroMatrix</td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"font-size:0;line-height:0;height:4px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr>\n          <td width=\"38%\" style=\"background:#8FA3FF;height:4px\"></td><td width=\"37%\" style=\"background:#E3A956;height:4px\"></td><td width=\"25%\" style=\"background:#E08BAA;height:4px\"></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:30px 28px 30px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.3px;color:#15171A;padding-bottom:10px\">Your login code</td></tr>\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#4B5058\">Type this code in the app to log in:</td></tr>\n          <tr><td style=\"padding:24px 0 6px\">\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF;border:1px solid #E4E1DA;border-radius:14px\">\n              <tr><td align=\"center\" style=\"padding:22px 12px\">\n                <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:36px;font-weight:700;letter-spacing:10px;color:#15171A\">{{ .Token }}</div>\n                <div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#676C75;padding-top:8px\">Valid for 15 minutes</div>\n              </td></tr>\n            </table>\n          </td></tr>\n          <tr><td style=\"padding-top:22px;border-bottom:1px solid #E4E1DA\"></td></tr>\n          <tr><td style=\"padding-top:18px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:#676C75\">Didn't ask for this? You can safely ignore this email.</td></tr>\n        </table>\n      </td></tr>\n    </table>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px\">\n      <tr><td align=\"center\" style=\"padding:18px 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#8B919A\">\n        MacroMatrix by DivineNet \u00b7 <a href=\"https://app.divinenet.online\" style=\"color:#8B919A\">app.divinenet.online</a><br>\n        You get this email because of an action on your MacroMatrix account.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>\n",
 "mailer_subjects_recovery": "Choose a new MacroMatrix password",
 "mailer_templates_recovery_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#F4F3EF\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF\">\n  <tr><td align=\"center\" style=\"padding:32px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px;background:#FFFFFF;border:1px solid #E4E1DA;border-radius:20px;overflow:hidden\">\n      <tr><td style=\"background:#0D0F11;padding:22px 28px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n          <td style=\"padding-right:12px\"><img src=\"https://app.divinenet.online/assets/img/logo-112.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;color:#ECEDEF\">MacroMatrix</td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"font-size:0;line-height:0;height:4px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr>\n          <td width=\"38%\" style=\"background:#8FA3FF;height:4px\"></td><td width=\"37%\" style=\"background:#E3A956;height:4px\"></td><td width=\"25%\" style=\"background:#E08BAA;height:4px\"></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:30px 28px 30px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.3px;color:#15171A;padding-bottom:10px\">Choose a new password</td></tr>\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#4B5058\">Type this code in the app to choose a new password:</td></tr>\n          <tr><td style=\"padding:24px 0 6px\">\n            <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF;border:1px solid #E4E1DA;border-radius:14px\">\n              <tr><td align=\"center\" style=\"padding:22px 12px\">\n                <div style=\"font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:36px;font-weight:700;letter-spacing:10px;color:#15171A\">{{ .Token }}</div>\n                <div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;color:#676C75;padding-top:8px\">Valid for 15 minutes</div>\n              </td></tr>\n            </table>\n          </td></tr>\n          <tr><td style=\"padding-top:22px;border-bottom:1px solid #E4E1DA\"></td></tr>\n          <tr><td style=\"padding-top:18px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:#676C75\">Didn't ask for a new password? Then you can ignore this email; your password stays the same.</td></tr>\n        </table>\n      </td></tr>\n    </table>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px\">\n      <tr><td align=\"center\" style=\"padding:18px 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#8B919A\">\n        MacroMatrix by DivineNet \u00b7 <a href=\"https://app.divinenet.online\" style=\"color:#8B919A\">app.divinenet.online</a><br>\n        You get this email because of an action on your MacroMatrix account.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>\n",
