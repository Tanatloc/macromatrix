 "mailer_subjects_password_changed_notification": "Your MacroMatrix password was changed",
 "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#F4F3EF\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"background:#F4F3EF\">\n  <tr><td align=\"center\" style=\"padding:32px 16px\">\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px;background:#FFFFFF;border:1px solid #E4E1DA;border-radius:20px;overflow:hidden\">\n      <tr><td style=\"background:#0D0F11;padding:22px 28px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n          <td style=\"padding-right:12px\"><img src=\"https://app.divinenet.online/assets/img/logo-112.png\" width=\"40\" height=\"40\" alt=\"\" style=\"display:block;border-radius:10px\"></td>\n          <td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:18px;font-weight:700;color:#ECEDEF\">MacroMatrix</td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"font-size:0;line-height:0;height:4px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\"><tr>\n          <td width=\"38%\" style=\"background:#8FA3FF;height:4px\"></td><td width=\"37%\" style=\"background:#E3A956;height:4px\"></td><td width=\"25%\" style=\"background:#E08BAA;height:4px\"></td>\n        </tr></table>\n      </td></tr>\n      <tr><td style=\"padding:30px 28px 30px\">\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\">\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;font-weight:700;letter-spacing:-0.3px;color:#15171A;padding-bottom:10px\">Your password was changed</td></tr>\n          <tr><td style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:1.55;color:#4B5058\">The password of your MacroMatrix account ({{ .Email }}) was just changed.</td></tr>\n          <tr><td style=\"padding-top:22px;border-bottom:1px solid #E4E1DA\"></td></tr>\n          <tr><td style=\"padding-top:18px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.55;color:#676C75\">Was this you? Then you don't need to do anything.<br>Wasn't it you? Choose a new password right away in the app via <b>Forgot password</b>, and email us at <a href=\"mailto:privacy@divinenet.online\" style=\"color:#0E6B65\">privacy@divinenet.online</a>.</td></tr>\n        </table>\n      </td></tr>\n    </table>\n    <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:480px\">\n      <tr><td align=\"center\" style=\"padding:18px 8px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#8B919A\">\n        MacroMatrix by DivineNet \u00b7 <a href=\"https://app.divinenet.online\" style=\"color:#8B919A\">app.divinenet.online</a><br>\n        You get this email because of an action on your MacroMatrix account.\n      </td></tr>\n    </table>\n  </td></tr>\n</table>\n</body></html>\n"
